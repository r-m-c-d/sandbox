#logiops known bug > launch on system start and looks up mouse config file but Bluetooth hasn't yet finished establishing system connection hence logid tries reading HID++ > result ('journalctl -u logid -b --no-pager
') = Bad file descriptor. Set 'After=bluetooth.target' unsufficient.
Workaround:
sudo nano /etc/udev/rules.d/99-logid-restart.rules
Insert:
ACTION=="add", SUBSYSTEM=="hidraw", RUN+="/usr/bin/systemctl restart logid.service"
Then reload rules:
sudo udevadm control --reload-rules

#Config file (for M720) located /etc/logid.cfg

devices: (
{
    name: "M720 Triathlon Multi-Device Mouse";
    smartshift:
    {
        on: true;
        threshold: 30;
    };
    hiresscroll:
    {
        hires: true;
        invert: false;
        target: false;
    };
    dpi: 1000;

    buttons: (
        {
            cid: 0x56;
            action =
            {
                type: "Keypress";
                keys: ["KEY_LEFTCTRL", "KEY_C"];
            };
        },
        {
            cid: 0x53;
            action =
            {
                type: "Keypress";
                keys: ["KEY_LEFTCTRL", "KEY_V"];
            };
        },
        {
            cid: 0xd0;
            action =
            {
                type: "Keypress";
                keys: ["KEY_ENTER"];
            };
        }
    );
}
);
